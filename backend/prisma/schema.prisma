generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CURATOR
  VIEWER
}

enum MuseumStatus {
  ACTIVE
  INACTIVE
}

enum ArtifactStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum VisitorEventType {
  SESSION_START
  ARTIFACT_VIEW
  QR_SCAN
  GALLERY_ENTER
  PERSONALIZATION_UPDATE
  SESSION_END
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artifacts Artifact[] @relation("ArtifactCreatedBy")
  media     Media[]    @relation("MediaUploadedBy")

  @@map("users")
}

model Museum {
  id           String       @id @default(cuid())
  name         String
  description  String?
  address      String?
  openingHours Json?
  coverImage   String?
  status       MuseumStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  galleries       Gallery[]
  artifacts       Artifact[]
  visitorSessions VisitorSession[]
  tourRoutes      TourRoute[]

  @@map("museums")
}

model Gallery {
  id          String   @id @default(cuid())
  museumId    String
  name        String
  description String?
  floor       String?
  room        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  museum        Museum         @relation(fields: [museumId], references: [id], onDelete: Cascade)
  artifacts     Artifact[]
  visitorEvents VisitorEvent[]

  @@index([museumId])
  @@map("galleries")
}

model Artifact {
  id           String         @id @default(cuid())
  museumId     String
  galleryId    String?
  /// Stable public key used by QR payloads and FE exhibit routes (e.g. adwa-victory)
  slug         String?        @unique
  title        String
  subtitle     String?
  description  String?
  era          String?
  category     String?
  status       ArtifactStatus @default(DRAFT)
  location     String?
  coverImage   String?
  /// Adult / researcher narrative paragraphs
  paragraphs   Json           @default("[]")
  /// Simplified story for under-18 / child mode
  kidsText     String?
  /// [{ "label": "Date", "value": "1 March 1896" }]
  facts        Json           @default("[]")
  youtubeId    String?
  videoCaption String?
  sortOrder    Int            @default(0)
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  museum        Museum          @relation(fields: [museumId], references: [id], onDelete: Cascade)
  gallery       Gallery?        @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  createdBy     User?           @relation("ArtifactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  media         Media[]
  qrCode        QrCode?
  qrScans       QrScan[]
  visitorEvents VisitorEvent[]
  routeStops    TourRouteStop[]

  @@index([museumId, status])
  @@index([galleryId])
  @@map("artifacts")
}

model Media {
  id           String    @id @default(cuid())
  artifactId   String?
  url          String
  type         MediaType
  filename     String?
  mimeType     String?
  size         Int?
  uploadedById String?
  createdAt    DateTime  @default(now())

  artifact   Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([artifactId])
  @@map("media")
}

model QrCode {
  id         String   @id @default(cuid())
  /// Scannable payload — usually the artifact slug
  code       String   @unique
  artifactId String   @unique
  url        String
  createdAt  DateTime @default(now())

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  scans    QrScan[]

  @@map("qr_codes")
}

model QrScan {
  id         String   @id @default(cuid())
  qrCodeId   String
  artifactId String
  sessionId  Int?
  ipAddress  String?
  userAgent  String?
  scannedAt  DateTime @default(now())

  qrCode   QrCode          @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  artifact Artifact        @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  session  VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([artifactId])
  @@index([sessionId])
  @@map("qr_scans")
}

model VisitorSession {
  id           Int       @id @default(autoincrement())
  token        String    @unique
  museumId     String?
  language     String    @default("en")
  interests    String[]  @default([])
  ageGroup     String?
  visitGoal    String?
  fullName     String?
  visitorType  String?
  education    String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  lastActiveAt DateTime  @default(now())

  museum  Museum?        @relation(fields: [museumId], references: [id], onDelete: SetNull)
  events  VisitorEvent[]
  qrScans QrScan[]

  @@index([museumId])
  @@index([visitorType])
  @@map("visitor_sessions")
}

model TourRoute {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  duration    String?
  /// Convenience count; prefer routeStops for ordered content
  stops       Int      @default(0)
  profile     String
  museumId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  museum     Museum?         @relation(fields: [museumId], references: [id], onDelete: SetNull)
  routeStops TourRouteStop[]

  @@index([profile])
  @@index([museumId])
  @@map("tour_routes")
}

model TourRouteStop {
  id         String  @id @default(cuid())
  routeId    String
  artifactId String?
  order      Int
  title      String?
  note       String?

  route    TourRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  artifact Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@unique([routeId, order])
  @@index([artifactId])
  @@map("tour_route_stops")
}

model VisitorEvent {
  id         Int              @id @default(autoincrement())
  sessionId  Int
  type       VisitorEventType
  artifactId String?
  galleryId  String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  session  VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  artifact Artifact?      @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  gallery  Gallery?       @relation(fields: [galleryId], references: [id], onDelete: SetNull)

  @@index([sessionId, type])
  @@index([sessionId, createdAt])
  @@map("visitor_events")
}
