NODE_ENV=development
PORT=5000

# Neon PostgreSQL (pooled — app runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct connection (Prisma migrations)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
