NODE_ENV=development
PORT=5000

# Neon PostgreSQL (pooled — app runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct connection (Prisma migrations)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Groq — text Q&A (+ Whisper for EN/FR/ZH voice)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini fallback (recommended if Groq Cloudflare verification fails)
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hugging Face — facebook/seamless-m4t-v2-large for Amharic & Afaan Oromo voice
HF_TOKEN=
HF_SEAMLESS_URL=https://router.huggingface.co/hf-inference/models/facebook/seamless-m4t-v2-large
